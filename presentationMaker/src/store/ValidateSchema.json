{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "type": "object",
    "properties": {
      "title": { 
        "type": "string", 
        "minLength": 1 
      },
      "slides": {
        "type": "array",
        "minItems": 1, 
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "background": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "color": { "type": "string" },
                    "type": { "const": "solid" }
                  },
                  "required": ["color", "type"]
                },
                {
                  "type": "object",
                  "properties": {
                    "src": { "type": "string" },
                    "type": { "const": "image" }
                  },
                  "required": ["src", "type"]
                }
              ]
            },
            "objects": {
              "type": "array",  
              "items": {
                "oneOf": [
                  { 
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "position": { "type": "object", "properties": { "X": { "type": "number" }, "Y": { "type": "number" } }, "required": ["X", "Y"] },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "text": { "type": "string" },
                        "fontsize": { "type": "number" },
                        "font": { "type": "string" },
                        "color": { "type": "string" },
                        "type": { "const": "text" }
                    },
                    "required": ["id", "position", "width", "height", "text", "fontsize", "font", "color", "type"]
                  },
                  { 
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "position": { "type": "object", "properties": { "X": { "type": "number" }, "Y": { "type": "number" } }, "required": ["X", "Y"] },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "src": { "type": "string" },
                        "type": { "const": "image" }
                    },
                    "required": ["id", "position", "width", "height", "src", "type"]
                  },
                  {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "position": { 
                        "type": "object",
                        "properties": {
                            "X": { "type": "number" },
                            "Y": { "type": "number" }
                        },
                        "required": ["X", "Y"]
                        },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "color": { "type": "string" },
                        "type": { "const": "circle" },
                        "radius": { "type": "number" }
                    },
                    "required": ["id", "position", "width", "height", "color", "type", "radius"]
                  },
                  {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "position": {
                        "type": "object",
                        "properties": {
                            "X": { "type": "number" },
                            "Y": { "type": "number" }
                        },
                        "required": ["X", "Y"]
                        },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "color": { "type": "string" },
                        "type": { "const": "rectangle" }
                    },
                    "required": ["id", "position", "width", "height", "color", "type"]
                  },
                  {
                    "type": "object",
                    "properties": {
                        "id": { "type": "string" },
                        "position": {
                        "type": "object",
                        "properties": {
                            "X": { "type": "number" },
                            "Y": { "type": "number" }
                        },
                        "required": ["X", "Y"]
                        },
                        "width": { "type": "number" },
                        "height": { "type": "number" },
                        "color": { "type": "string" },
                        "type": { "const": "triangle" },
                        "pointOne": { "type": "object" },
                        "pointTwo": { "type": "object" },
                        "pointThree": { "type": "object" }
                    },
                    "required": ["id", "position", "width", "height", "color", "type", "pointOne", "pointTwo", "pointThree"]
                  }
                ]
              }
            }
          },
          "required": ["id", "background", "objects"]
        }
      }
    },
    "required": ["title", "slides"]
  }